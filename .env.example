# --- storage ---------------------------------------------------------------
# On Railway, mount a volume at /data and point this at it so the store survives
# redeploys. Without a volume the service re-bootstraps on every deploy.
TALAIA_DATA_DIR=/data

# --- OpenStreetMap ---------------------------------------------------------
# Comma-separated, tried in order with per-mirror health tracking. Overpass is a
# volunteer service: individual mirrors go down or are unreachable from a given
# network, so more than one is not optional.
TALAIA_OVERPASS_MIRRORS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
TALAIA_OSM_TILE_DEG=0.05
TALAIA_OSM_TILE_TTL_HOURS=336
TALAIA_OSM_MAX_TILES_PER_REQUEST=96

# --- upstream --------------------------------------------------------------
# Optional. Raises the Socrata anonymous rate limit for the Catalan registries.
# TALAIA_SOCRATA_APP_TOKEN=

# --- authentication --------------------------------------------------------
# The API is gated by default. If this is true and no keys exist, the service mints one
# at first boot and prints it to the logs ONCE - capture it from the deploy log.
TALAIA_REQUIRE_AUTH=true

# Comma-separated keys for zero-setup deploys. Either "key" or "label:key".
# Anything set here is valid in addition to keys created through the admin endpoints.
# TALAIA_API_KEYS=deepfire:talaia_sk_xxxxxxxx,partner:talaia_sk_yyyyyyyy

# Enables POST/GET/DELETE /v1/admin/keys. Leave unset to disable key management
# entirely (the endpoints then return 404 rather than advertising themselves).
# TALAIA_ADMIN_KEY=

# Default per-key budget. Override per key when minting one.
TALAIA_RATE_LIMIT_PER_MIN=120

# /v1/sources, /v1/taxonomy and /v1/stats describe the service rather than returning
# exposure data, and the public docs site renders them. Set false to gate everything.
TALAIA_PUBLIC_METADATA=true

# --- behaviour -------------------------------------------------------------
TALAIA_ENABLE_LIVE_OSM=true
TALAIA_AUTO_BOOTSTRAP=true      # load resident sources in-process if the store is empty
TALAIA_CORE_IMPL=auto           # auto | rust | python
TALAIA_MAX_AOI_KM2=25000
TALAIA_MAX_ASSETS_RETURNED=20000
TALAIA_CORS_ORIGINS=*
