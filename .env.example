# --- storage ---------------------------------------------------------------
# On Railway, mount a volume at /data and point this at it so the store survives
# redeploys. Without a volume the service re-bootstraps on every deploy.
TALAIA_DATA_DIR=/data

# --- OpenStreetMap ---------------------------------------------------------
# Comma-separated, tried in order with per-mirror health tracking. Overpass is a
# volunteer service: individual mirrors go down or are unreachable from a given
# network, so more than one is not optional.
TALAIA_OVERPASS_MIRRORS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
TALAIA_OSM_TILE_DEG=0.05
TALAIA_OSM_TILE_TTL_HOURS=336
TALAIA_OSM_MAX_TILES_PER_REQUEST=96

# Pre-load the tile cache for these regions in the background at boot, so a demo area
# answers from local storage instead of paying an Overpass round-trip. Names come from
# `python -m talaia regions`; a raw "min_lon,min_lat,max_lon,max_lat" also works.
# Warm the areas you will actually show - a whole country is days of Overpass time.
# TALAIA_WARM_ON_BOOT=demo
TALAIA_WARM_MAX_PARALLEL=2
TALAIA_WARM_PAUSE_S=1.0
TALAIA_WARM_GROUP_TILES=16

# --- upstream --------------------------------------------------------------
# Optional. Raises the Socrata anonymous rate limit for the Catalan registries.
# TALAIA_SOCRATA_APP_TOKEN=

# --- authentication --------------------------------------------------------
# The API is gated by default. If this is true and no keys exist, the service mints one
# at first boot and prints it to the logs ONCE - capture it from the deploy log.
TALAIA_REQUIRE_AUTH=true

# Comma-separated keys for zero-setup deploys. Either "key" or "label:key".
# Anything set here is valid in addition to keys created through the admin endpoints.
# TALAIA_API_KEYS=deepfire:talaia_sk_xxxxxxxx,partner:talaia_sk_yyyyyyyy

# Enables POST/GET/DELETE /v1/admin/keys. Leave unset to disable key management
# entirely (the endpoints then return 404 rather than advertising themselves).
# TALAIA_ADMIN_KEY=

# Default per-key budget for keys defined in TALAIA_API_KEYS. Set 0 for no rate limit.
TALAIA_RATE_LIMIT_PER_MIN=120

# Retune tier quotas without a code change. Partial objects patch the built-in tier;
# an unknown name defines a new tier on top of the free-tier defaults. Malformed JSON
# is ignored and logged, so a typo cannot accidentally remove a cap.
# TALAIA_TIER_LIMITS={"free":{"max_aoi_km2":500,"daily_quota":5000}}

# Self-service signup. Issues a free-tier key immediately: 250 km2 per call, 60 req/min,
# 1000 req/day. Abuse controls are one active key per email plus a per-IP daily cap.
TALAIA_ALLOW_SIGNUP=true
TALAIA_SIGNUPS_PER_IP_PER_DAY=3
TALAIA_SIGNUP_TIER=free

# Email verification. On by default: without it the address on a key is an unchecked
# string. No key exists until the mailed link is followed, so an address nobody
# controls produces nothing. With verification on and no mail sender configured,
# signup returns 503 rather than quietly issuing unverified keys.
TALAIA_REQUIRE_EMAIL_VERIFICATION=true
TALAIA_VERIFICATION_TTL_HOURS=24

# Absolute base URL for the link in that email. Behind Railway's proxy the request's
# own host is the internal one, so set this explicitly.
TALAIA_PUBLIC_URL=https://your-app.up.railway.app

# --- outbound email --------------------------------------------------------
# Simplest: one Resend API key and nothing else. Get one at resend.com/api-keys.
TALAIA_RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# With no TALAIA_EMAIL_FROM, mail goes out as Resend's shared onboarding@resend.dev.
# That needs no DNS at all, but Resend will ONLY deliver to the address that owns the
# account - fine for testing, useless once anyone else tries to sign up. Verify a
# domain at resend.com/domains and set this before opening signup to the public.
# TALAIA_EMAIL_FROM=TALAIA <noreply@your-domain.example>

# Check it without waiting for a real signup:
#   curl -X POST $TALAIA/v1/admin/email/test -H "X-Admin-Key: $ADMIN" \
#        -H 'content-type: application/json' -d '{"to":"you@example.com"}'
# It returns Resend's own error, which is usually the whole diagnosis.

# Alternative: any SMTP provider. Used only when no Resend key is set.
# TALAIA_SMTP_HOST=smtp.example.com
# TALAIA_SMTP_PORT=587
# TALAIA_SMTP_USER=...
# TALAIA_SMTP_PASSWORD=...
# TALAIA_SMTP_STARTTLS=true
# TALAIA_SMTP_SSL=false

# Local development only: log the message instead of sending it, and return the
# verification link in the signup response. Never enable this on a public deployment.
# TALAIA_EMAIL_CONSOLE=true

# /v1/sources, /v1/taxonomy and /v1/stats describe the service rather than returning
# exposure data, and the public docs site renders them. Set false to gate everything.
TALAIA_PUBLIC_METADATA=true

# --- behaviour -------------------------------------------------------------
TALAIA_ENABLE_LIVE_OSM=true
TALAIA_AUTO_BOOTSTRAP=true      # load resident sources in-process if the store is empty
TALAIA_CORE_IMPL=auto           # auto | rust | python
TALAIA_MAX_AOI_KM2=25000
TALAIA_MAX_ASSETS_RETURNED=20000
TALAIA_CORS_ORIGINS=*
